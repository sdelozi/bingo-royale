# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Database (local Docker default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bingo_royale?schema=public

# Auth.js
AUTH_SECRET=replace-with-a-long-random-secret
# Optional for Google OAuth in v1
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Optional credentials auth hardening
CREDENTIALS_PASSWORD_PEPPER=replace-me

# Optional polling controls (milliseconds)
NEXT_PUBLIC_POLL_INTERVAL_MS=15000
NEXT_PUBLIC_POLL_MAX_INTERVAL_MS=120000
