{
  "name": "bingo-royale",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "stop:local": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-local.ps1",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:portability": "node ./scripts/check-portability.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke:target": "node ./scripts/smoke-hosting-target.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "next": "^15.5.24",
    "next-auth": "^4.24.15",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "14.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.16.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.5.24",
    "jsdom": "22.1.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3",
    "undici": "^6.28.1",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
